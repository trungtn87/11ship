# Copy to .env for local development. .env is git-ignored. Values below are placeholders only.

# --- Application ---
# Startup validates these. A bad or missing value exits nonzero and names only the variable.
# APP_ENV: development | test | staging | production (required)
APP_ENV=development
# NODE_ENV: development | test | production (never "staging")
NODE_ENV=development
HOST=127.0.0.1
# PORT: integer 1..65535
PORT=3000
# DATABASE_URL is required in every environment. There is no fallback.
DATABASE_URL=postgres://ship11_dev:change_me_dev@127.0.0.1:5432/ship11_dev

# --- Database pool (all bounded) ---
# DB_POOL_MAX: 1..50
DB_POOL_MAX=10
# All timeouts are 100..30000 ms.
DB_CONNECT_TIMEOUT_MS=1000
# Client-side per-query timeout. Must be LARGER than DB_STATEMENT_TIMEOUT_MS so PostgreSQL's own
# cancellation arrives first and the connection stays usable.
DB_QUERY_TIMEOUT_MS=1000
# Server-side statement_timeout.
DB_STATEMENT_TIMEOUT_MS=800

# --- Transactions (M00-C1A0) ---
# Total budget of one transaction. Must be LARGER than DB_STATEMENT_TIMEOUT_MS.
DB_TRANSACTION_TIMEOUT_MS=5000
# idle_in_transaction_session_timeout applied to every transaction.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=2000

# --- Idempotency (M00-C1A1) ---
# Advisory-lock wait before IDEMPOTENCY_BUSY: 1..5000 ms, must be SMALLER than DB_STATEMENT_TIMEOUT_MS.
IDEMPOTENCY_ADVISORY_WAIT_MS=250
# lock_timeout restored for business/row locks after the advisory lock: 1..30000 ms, SMALLER than
# DB_STATEMENT_TIMEOUT_MS.
IDEMPOTENCY_BUSINESS_LOCK_TIMEOUT_MS=500
# 1 <= replay <= dedupe <= 604800 seconds.
IDEMPOTENCY_REPLAY_TTL_SECONDS=900
IDEMPOTENCY_DEDUPE_TTL_SECONDS=604800

# --- Outbox dispatcher (M00-C1C) ---
# Read by loadConfig and validated at startup. NOTHING starts a dispatcher on its own: there is no production
# worker or poll loop yet; these bounds are for the future worker and for the tests.
# Claims after which an event is DEAD instead of retried: 1..20
OUTBOX_MAX_ATTEMPTS=5
# Most events one dispatch cycle may claim (the real limit is min(batch, free publish slots)): 1..100
OUTBOX_BATCH_SIZE=10
# Most underlying publisher promises that may be unsettled at once, per dispatcher: 1..100
OUTBOX_PUBLISH_CONCURRENCY=10
# After this long a publish counts as PUBLISH_TIMEOUT (its slot is kept until the call really settles): 100..300000 ms
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# A PROCESSING row older than this (PostgreSQL time) may be reclaimed: 100..300000 ms.
# MUST be larger than OUTBOX_PUBLISH_TIMEOUT_MS + 2000.
OUTBOX_LEASE_MS=30000
# Retry delay = min(OUTBOX_BACKOFF_CAP_MS, OUTBOX_BACKOFF_BASE_MS * 2^(attempt_count - 1)), no jitter: 100..300000 ms.
# BASE must be <= CAP.
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_CAP_MS=60000

# --- Crypto keyring (optional for the plain server; REQUIRED wherever the idempotency executor is wired) ---
# If you set one of these you must set both. NEVER commit real keys; production keys come from a
# secret manager / secret injection, not from this file.
#   CRYPTO_ACTIVE_KEY_ID: key id used for NEW records, [A-Za-z0-9_-]{1,64}
#   CRYPTO_KEYRING: comma-separated "<key id>:<base64 of exactly 32 random bytes>" entries; it must
#   contain the active key and every historical key that records may still depend on.
# Generate a key:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# CRYPTO_ACTIVE_KEY_ID=local-key-1
# CRYPTO_KEYRING=local-key-1:<base64-of-32-random-bytes>

# --- Auth Core (M01-A1) ---
# AUTH_OTP_HMAC_SECRET is REQUIRED to start the server (base64 of EXACTLY 32 random bytes). NEVER commit a real
# value; staging/production secrets come from a secret manager. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# AUTH_OTP_HMAC_SECRET=<base64-of-32-random-bytes>
# The in-memory FAKE OTP provider is bound only for APP_ENV=development|test. There is no production SMS adapter
# yet, so APP_ENV=staging|production refuse to start (the error names only OTP_PROVIDER). The fake never logs OTPs.
# Optional tuning (defaults shown, allowed range in brackets):
# [30..600]
AUTH_OTP_TTL_SECONDS=300
# [1..300]
AUTH_OTP_RESEND_SECONDS=60
# [1..10]
AUTH_OTP_MAX_ATTEMPTS=5
# [60..1800]
AUTH_PROOF_TTL_SECONDS=600
# [300..2592000], absolute lifetime, no refresh token
AUTH_SESSION_TTL_SECONDS=604800

# --- Database TLS and remote migrations (M00-D1) ---
# Local development and CI need none of this: without a CA the pool is built exactly as before.
# APP_ENV=staging|production REFUSE to start without exactly one of the two CA variables below (the error names only
# the variables). With a CA the server certificate chain AND host name are verified; DATABASE_URL must then have NO
# query string (an ?sslmode=... in the URL would override the verified settings, so it is refused), and the
# process-wide NODE_TLS_REJECT_UNAUTHORIZED=0 is refused. Use a DNS host name from the provider, not an IP address.
#   DB_SSL_CA        PEM text of the CA (a single line with literal \n is accepted, as secret stores often produce)
#   DB_SSL_CA_FILE   path of a secret file holding that PEM (for example a Render secret file)
# DB_SSL_CA=<PEM of the CA>
# DB_SSL_CA_FILE=/etc/secrets/db-ca.crt
# `npm run db:migrate:remote` (see ops/runbooks/render-supabase-staging.md) is the only remote migration path. It reads
# the MIGRATION credential, which is NOT the runtime DATABASE_URL and never lives on the Render service. Set these in
# the operator's shell only, never in a file:
# MIGRATION_DATABASE_URL=postgres://<migration role>:<password>@<session pooler host>:5432/postgres
# MIGRATION_CONFIRM_TARGET=<session pooler host>/postgres

# --- Administration web login (M01-D-LOGIN) ---
# Off by default. When ADMIN_AUTH_ENABLED=true ALL of these must be valid, or the service refuses to start (the error
# names only the variables). Placeholders only - never commit real values.
# ADMIN_AUTH_ENABLED=false
# ADMIN_AUTH_ALLOWED_ORIGINS=["https://admin.example.invalid"]   # JSON array of exact https origins
# ADMIN_AUTH_TRUSTED_PROXY_IPS=[]                                  # JSON array of exact IP literals; default none
# ADMIN_RATE_LIMIT_HMAC_KEY=<base64 of 32 random bytes>
# ADMIN_RATE_LIMIT_KEY_ID=limiter-1
# M01-D-ADMIN-1B (ADMIN invitations by the SYSTEM administrator):
# ADMIN_ACTIVATION_ORIGIN=https://admin.example.invalid           # REQUIRED when enabled; one of ADMIN_AUTH_ALLOWED_ORIGINS
# ADMIN_INVITATION_TTL_HOURS=72                                    # optional; integer 1..168; absent = 72
# M01-D-ADMIN-1C (account activation by the invited administrator). OFF by default; needs ADMIN_AUTH_ENABLED=true:
# ADMIN_ACTIVATION_ENABLED=false
# ADMIN_ACTIVATION_OTP_MODE=FAKE                                   # REQUIRED when enabled. FAKE / TEST_DISPLAY: APP_ENV development or test ONLY; SMS has no adapter yet and refuses startup
# ADMIN_ACTIVATION_OTP_PROVIDER_TIMEOUT_MS=8000                    # optional; 500..30000
# ADMIN_ACTIVATION_OTP_PROMOTE_GRACE_MS=10000                      # optional; 1000..60000
# Contract section 7 values (defaults ARE section 7). Ranges are an implementation choice awaiting ChatGPT/Owner confirmation.
# The per-attempt wrong OTP / wrong TOTP limits (5) and the TOTP bucket limit (5) are fixed by the schema: NOT variables.
# ADMIN_ACTIVATION_ATTEMPT_TTL_SECONDS=1800   # optional; 1..3600 (DDL ceiling: attempt lifetime <= 1 hour)
# ADMIN_ACTIVATION_OTP_TTL_SECONDS=300   # optional; 1..600 (DDL ceiling: 10 minutes)
# ADMIN_ACTIVATION_OTP_RESEND_COOLDOWN_SECONDS=60   # optional; 1..86400
# ADMIN_ACTIVATION_PASSWORD_DEADLINE_SECONDS=600   # optional; 1..86400
# ADMIN_ACTIVATION_OTP_SEND_LIMIT=5   # optional; 1..1000 per invitation per window
# ADMIN_ACTIVATION_OTP_SEND_WINDOW_SECONDS=3600   # optional; 1..86400
# ADMIN_ACTIVATION_REQUEST_LIMIT=30   # optional; 1..1000 POST per address per window
# ADMIN_ACTIVATION_REQUEST_WINDOW_SECONDS=60   # optional; 1..86400
# ADMIN_ACTIVATION_LINK_FAILURE_LIMIT=10   # optional; 1..1000
# ADMIN_ACTIVATION_LINK_FAILURE_WINDOW_SECONDS=900   # optional; 1..86400
# ADMIN_ACTIVATION_LINK_FAILURE_LOCK_SECONDS=900   # optional; 1..86400
# ADMIN_ACTIVATION_TOTP_FAILURE_WINDOW_SECONDS=900   # optional; 1..86400
# ADMIN_ACTIVATION_TOTP_FAILURE_LOCK_SECONDS=900   # optional; 1..86400
# The two operator commands (npm run admin-auth:init-limit-config, admin-auth:bootstrap-system) are described in
# ops/runbooks/render-supabase-staging.md. Bootstrap credentials are read from standard input only.

# --- docker compose (compose.dev.yml) ---
DEV_DB_PASSWORD=change_me_dev
TEST_DB_PASSWORD=change_me_test

# --- Integration tests ---
# Set these in the shell (not in this file) before `npm run test:integration`:
#   APP_ENV=test
#   DATABASE_URL=postgres://ship11_test:<TEST_DB_PASSWORD>@127.0.0.1:5433/ship11_test
# The guard only accepts database "ship11_test" with user "ship11_test".
