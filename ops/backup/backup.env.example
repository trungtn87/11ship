# /etc/11ship/backup/backup.env  (root:root, mode 0600)  — example. Copy, fill in, never commit the filled-in file.
# Holds NO passphrase, NO Google token and NO ingest key: those are separate files / systemd credentials (see ops/runbooks/m12-drive-backup-20261024.md).

# The database to back up: the OWNER/migrator role of ship11_staging (it writes app.backup_records and app.backup_jobs). TLS settings as in /root/ship11-secrets/operator.env.
BACKUP_SOURCE_URL=postgres://ship11_migrator@localhost:5432/ship11_staging?sslmode=verify-full
# A server where scratch databases ship11_verify_* / ship11_restore_* may be created for the restore check (the VPS PostgreSQL itself is fine). Database "postgres".
BACKUP_SCRATCH_URL=postgres://ship11_migrator@localhost:5432/postgres?sslmode=verify-full

# Local spool of ENCRYPTED copies (mode 0700). Copies verified on Drive keep only the newest BACKUP_KEEP_LOCAL_VERIFIED; copies not sent yet stay for the retry.
BACKUP_DIR=/var/backups/11ship/spool
BACKUP_SPOOL_MAX_MB=4096
BACKUP_SPOOL_WARN_PERCENT=80
BACKUP_MIN_FREE_MB=1024
BACKUP_KEEP_LOCAL_VERIFIED=2
BACKUP_UPLOAD_ATTEMPTS=5

# Google Drive through rclone. The remote name is the one created by `rclone config`; the folder is created by the job (scope drive.file: only files made by this app are visible to it).
BACKUP_RCLONE=/usr/bin/rclone
BACKUP_RCLONE_CONFIG=/etc/11ship/backup/rclone.conf
BACKUP_REMOTE=gdrive:11Ship-Backup

# Files outside the database to include (space separated absolute paths). EMPTY today: menu pictures, shop logos and complaint pictures are stored INSIDE the database.
# Set this only if a directory of uploads ever appears; nothing else about the job changes.
BACKUP_EXTRA_PATHS=

# Release and commit shown in the manifest (no secret).
BACKUP_RELEASE_FILE=/opt/11ship/current/RELEASE.json

# Report to M13 (Discord alerts + Web Admin health). The key is a BACKUP-scope machine credential created with `ops:ctl ingest-key create --scope BACKUP`; keep it as a systemd credential.
BACKUP_OPS_URL=https://11ship.example/v1/ops/ingest/backup
