[Unit]
Description=11Ship backup BEFORE a deploy that carries a migration (started by the updater, not by a timer)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/11ship/backup/backup.env
LoadCredentialEncrypted=backup-passphrase:/etc/11ship/backup/passphrase.cred
LoadCredentialEncrypted=ops-ingest-key:/etc/11ship/backup/ops-ingest-key.cred
Environment=BACKUP_PASSPHRASE_FILE=%d/backup-passphrase
Environment=BACKUP_INGEST_KEY_FILE=%d/ops-ingest-key
# Kind PRE_MIGRATION: kept apart from the daily and weekly chains (retention keeps the newest one), so a deploy never pushes a daily or weekly copy out.
Environment=BACKUP_KIND=PRE_MIGRATION
Environment=BACKUP_TRIGGER=DEPLOY
ExecStart=/opt/11ship/tools/backup/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/backups/11ship /etc/11ship/backup
