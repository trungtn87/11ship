# CONTENT of /etc/11ship/staging.env after the cut-over (the file and the unit name 11ship-staging.service are kept so nothing else changes) — environment of the 11Ship SERVICE as the real operating build (Owner decision 2026-10-14).
# TEMPLATE: every <placeholder> is filled in on the VPS by the operator; no real value is committed anywhere.
# The migration credential (ship11_migrator) is NEVER in this file: only the operator shell holds it.
# Update an existing /etc/11ship/staging.env IN PLACE with ops/runbooks/vps-production-update-20261014.md (keep the keys, the database
# password, ADMIN_RATE_LIMIT_* and CRYPTO_* values that already exist: they protect existing data and sessions). Do not overwrite secrets.
APP_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=5000

# Runtime role only, same database as before (the name ship11_staging does not decide the environment; nothing is renamed or moved).
DATABASE_URL=postgres://ship11_app:<app-password-already-in-the-current-env>@localhost:5432/ship11_staging
DB_SSL_CA_FILE=/etc/11ship/db-ca.crt

# No fixture mode, no test inbox, no DISABLED_TEST anywhere: AUTH_STAGING_* and every *_DISABLED_TEST / TEST_* variable are REMOVED.
AUTH_OTP_HMAC_SECRET=<unchanged from the current env>
CRYPTO_ACTIVE_KEY_ID=<unchanged>
CRYPTO_KEYRING=<unchanged: the existing key ids must stay; a new key may be ADDED and made active, never dropped>

# Administration web served by the same process on ONE https origin, with its authentication, activation and USER lock.
ADMIN_WEB_STAGING_ENABLED=true
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_ALLOWED_ORIGINS=["https://103.9.78.67.sslip.io"]
ADMIN_ACTIVATION_ORIGIN=https://103.9.78.67.sslip.io
ADMIN_AUTH_TRUSTED_PROXY_IPS=["127.0.0.1"]
ADMIN_RATE_LIMIT_KEY_ID=<unchanged>
ADMIN_RATE_LIMIT_HMAC_KEY=<unchanged>
ADMIN_ACTIVATION_ENABLED=true
ADMIN_ACTIVATION_OTP_MODE=SMS
ADMIN_USER_ACCOUNT_MUTATIONS_ENABLED=true

# SMS gateway (the paired Android phone; see ops/runbooks/sms-gateway.md). ALLOWLIST until the Owner has confirmed the SIM / carrier
# terms and switches to OPEN (SMS_GATEWAY_RECIPIENT_MODE=OPEN) on purpose: with ALLOWLIST only these numbers can receive any code.
SMS_GATEWAY_ENABLED=true
SMS_GATEWAY_RECIPIENT_MODE=ALLOWLIST
SMS_GATEWAY_ALLOWLIST=<comma separated numbers chosen by the Owner>
ACCOUNT_RECOVERY_MODE=SMS_OTP

# Client registration consent: the pair the apps send (mobile/packages/n11_shared/lib/src/account/session_controller.dart).
# Texts: docs/current/M01-terms-privacy-20261014.md. Changing a text means a new pair here AND in the apps.
CLIENT_AUTH_TERMS_VERSION=terms-20261014-v1
CLIENT_AUTH_PRIVACY_VERSION=privacy-20261014-v1

# Native Android device proof: persistent signer, pinned attestation roots, revocation snapshot. Real inputs only (see the runbook).
CLIENT_AUTH_ANDROID_ENABLED=true
CLIENT_DEVICE_ENVIRONMENT=ship11-test
CLIENT_DEVICE_ALLOWED_SIGNERS_FILE=/etc/11ship/trust/android-signers.json
CLIENT_DEVICE_ATTESTATION_ROOTS_FILE=/etc/11ship/trust/android-attestation-roots.pem
CLIENT_DEVICE_ATTESTATION_REVOCATION_FILE=/etc/11ship/trust/android-attestation-revocation.json
