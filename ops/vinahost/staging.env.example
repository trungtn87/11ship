# /etc/11ship/staging.env — environment of the 11Ship staging SERVICE (root:ship11, mode 0640).
# This is a TEMPLATE: every <placeholder> is filled in on the VPS by the operator; no real value is committed anywhere.
# The migration credential (ship11_migrator) is NEVER in this file: only the operator shell holds it.
APP_ENV=staging
NODE_ENV=production
# Backend listens on loopback only; nginx is the only public listener.
HOST=127.0.0.1
PORT=3000
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=5000

# Runtime role only. host must be "localhost" (the server certificate names only localhost); no query string.
DATABASE_URL=postgres://ship11_app:<app-password-from-/root/ship11-secrets/app.pw>@localhost:5432/ship11_staging
DB_SSL_CA_FILE=/etc/11ship/db-ca.crt

# Staging fixture mode: operator-seeded fixture accounts; OTP / registration stay closed. No TEST_INBOX provider
# (OTP_PROVIDER / ADMIN_ACTIVATION_OTP_MODE are deliberately absent) on a public host.
AUTH_STAGING_FIXTURES_ENABLED=true
AUTH_STAGING_ALLOWED_PHONES=<JSON array of up to 20 normalized +84 numbers chosen by the Owner>
AUTH_OTP_HMAC_SECRET=<base64 of exactly 32 random bytes>
CRYPTO_ACTIVE_KEY_ID=staging-1
CRYPTO_KEYRING=staging-1:<base64 of exactly 32 random bytes>

# Administration web served by the same process, on ONE https origin (the administration cookies are __Host- cookies).
ADMIN_WEB_STAGING_ENABLED=true
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_ALLOWED_ORIGINS=["https://103.9.78.67.sslip.io"]
ADMIN_ACTIVATION_ORIGIN=https://103.9.78.67.sslip.io
# nginx on this host is the only proxy; it overwrites X-Forwarded-For with the single client address it saw.
ADMIN_AUTH_TRUSTED_PROXY_IPS=["127.0.0.1"]
# Same pair the operator used for admin-auth:init-limit-config (not changed on restart or deploy).
ADMIN_RATE_LIMIT_KEY_ID=staging-1
ADMIN_RATE_LIMIT_HMAC_KEY=<base64 of 32 random bytes, identical to the operator value>
# Activation of invited administrators needs an SMS adapter that does not exist yet: stays OFF.
ADMIN_ACTIVATION_ENABLED=false
