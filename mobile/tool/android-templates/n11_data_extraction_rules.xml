<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device transfer of any app data: the session token store and the device metadata must not
     leave the phone (they would be useless elsewhere anyway: the key is bound to this phone's Keystore). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
