{
  "version": 8,
  "name": "Cao Bằng offline",
  "glyphs": "asset://caobang/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "caobang": {
      "type": "geojson",
      "data": "asset://caobang/map.geojson",
      "attribution": "© OpenStreetMap contributors",
      "maxzoom": 18
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f3e9"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "land"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ]
      ],
      "paint": {
        "fill-color": "#d9e5cf",
        "fill-opacity": 0.75
      },
      "layout": {},
      "minzoom": 0
    },
    {
      "id": "water-area",
      "type": "fill",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "water"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ]
      ],
      "paint": {
        "fill-color": "#9dcfe2"
      },
      "layout": {},
      "minzoom": 0
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "water"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "paint": {
        "line-color": "#9dcfe2",
        "line-width": 3
      },
      "layout": {},
      "minzoom": 0
    },
    {
      "id": "building",
      "type": "fill",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "building"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "Polygon"
        ]
      ],
      "paint": {
        "fill-color": "#d7c9b9",
        "fill-outline-color": "#c0b29f"
      },
      "layout": {},
      "minzoom": 14
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "road"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "paint": {
        "line-color": "#c7bbaa",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          14,
          5,
          18,
          13
        ]
      },
      "layout": {},
      "minzoom": 0
    },
    {
      "id": "road",
      "type": "line",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "road"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "highway"
          ],
          [
            "primary",
            "secondary",
            "trunk",
            "motorway"
          ],
          "#f0cb7a",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.6,
          14,
          3,
          18,
          10
        ]
      },
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "minzoom": 0
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "road"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ]
      ],
      "paint": {
        "text-color": "#5a5045",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      },
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "minzoom": 14
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "place"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "Point"
        ]
      ],
      "paint": {
        "text-color": "#263c46",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      },
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 14
      },
      "minzoom": 0
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "caobang",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "kind"
          ],
          "poi"
        ],
        [
          "==",
          [
            "geometry-type"
          ],
          "Point"
        ]
      ],
      "paint": {
        "text-color": "#66507b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      },
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:vi"
          ],
          [
            "get",
            "name"
          ],
          ""
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "minzoom": 15
    }
  ]
}