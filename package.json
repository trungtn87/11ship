{
  "name": "11ship",
  "version": "0.0.0",
  "private": true,
  "description": "11Ship — backend foundation (task M00-B1)",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env apps/backend/dist/main.js",
    "start": "node apps/backend/dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p apps/backend/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p apps/admin-web/tsconfig.json --noEmit && tsc -p apps/ui-foundation/tsconfig.json --noEmit",
    "build": "npm run build --workspace apps/backend",
    "build:admin-web": "node scripts/admin-web-build.mjs",
    "build:ui-foundation": "node scripts/client-web-build.mjs ui-foundation --design",
    "ui:preview": "node scripts/ui-preview.mjs --open",
    "client-shell:test": "node --test \"tests/client-shell/*.test.mjs\"",
    "admin-web:cert": "node scripts/admin-web-cert.mjs",
    "admin-web:dev": "node scripts/admin-web-dev.mjs",
    "clean:test": "node scripts/clean-dir.js .test-dist",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migrate:remote": "node scripts/db-migrate-remote.js",
    "admin-auth:init-limit-config": "node scripts/admin-auth-init-limit-config.js",
    "admin-auth:bootstrap-system": "node scripts/admin-auth-bootstrap-system.js",
    "deploy:validate": "node scripts/deploy/validate-render-blueprint.mjs",
    "deploy:test": "node --test \"tests/deploy/*.test.mjs\"",
    "launcher:test": "node --test \"tests/local-launcher/*.test.mjs\"",
    "test:unit": "npm run build:test && jest --config jest.unit.config.js",
    "test:integration": "npm run build:test && node .test-dist/tests/integration/support/guard-cli.js && jest --config jest.integration.config.js --runInBand",
    "progress:generate": "node scripts/generate-progress.mjs",
    "progress:check": "node scripts/generate-progress.mjs --check",
    "progress:test": "node --test \"tests/progress/*.test.mjs\""
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "11.2.7",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "node-pg-migrate": "8.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
