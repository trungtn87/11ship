    },
    {
      "name": "Prepare the iOS project (push must be on for a release)",
      "env": {
        "FCM_PROJECT_ID": "${{ vars.FCM_PROJECT_ID }}",
        "FCM_SENDER_ID": "${{ vars.FCM_SENDER_ID }}",
        "FCM_APP_ID": "${{ inputs.app == 'ship' && vars.FCM_SHIP_IOS_APP_ID || vars.FCM_FOOD_IOS_APP_ID }}",
        "FCM_API_KEY": "${{ inputs.app == 'ship' && secrets.FCM_SHIP_IOS_API_KEY || secrets.FCM_FOOD_IOS_API_KEY }}",
        "IOS_APS_ENVIRONMENT": "production"
      },
      "run": "sha256:97b3b16d582228cc9b7702b4c89ea4366a7f66abc3c5284cb155e0f71c09feb6"
    },
    {
      "name": "Build, sign and upload to TestFlight (the only step with the API key)",
      "env": {
        "IOS_ASC_KEY_P8_BASE64": "${{ secrets.IOS_ASC_KEY_P8_BASE64 }}",
        "IOS_ASC_KEY_ID": "${{ vars.IOS_ASC_KEY_ID }}",
        "IOS_ASC_ISSUER_ID": "${{ vars.IOS_ASC_ISSUER_ID }}",
        "IOS_TEAM_ID": "${{ vars.IOS_TEAM_ID }}"
      },
      "run": "sha256:8acf4997cb1bfca597e602b25f729aed4b0166f3c8ec30f43e696485271ec36f"
    }
  ],
