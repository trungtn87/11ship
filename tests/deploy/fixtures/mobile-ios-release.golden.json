{
  "_about": "Golden shape of the iOS release job (mobile-ios-release.yml:testflight). Any workflow step change must change this file in the same review. scriptPins mirrors mobile/release/script-pins.sha256. Compared by ci-gate-policy.test.mjs.",
  "steps": [
    {
