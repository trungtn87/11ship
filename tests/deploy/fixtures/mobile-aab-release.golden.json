{
  "_about": "Golden shape of the release job (mobile-aab-release.yml:aab). Any workflow step change must change this file in the same review. scriptPins mirrors mobile/release/script-pins.sha256 (SHA-256 of each release script, LF content). Compared by ci-gate-policy.test.mjs.",
  "steps": [
    {
      "name": "Run only from main",
      "run": "sha256:0f8fc5a126b6dd4cfaf6a8db1154d0679b826bed7de91a0d8cd13f15abbd6f89"
    },
    {
      "name": "Require the public app-signer pin (no upload secret here)",
      "env": {
        "APP_SIGNER_PIN": "${{ vars.ANDROID_APP_SIGNER_SHA256 }}"
      },
      "run": "sha256:9d4a24dccf6573288951a99864af7be6420f774be4ccb7ab50f30cf97a3b39c2"
    },
    {
      "name": "Check out the exact source commit",
      "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
      "with": {
        "ref": "${{ github.sha }}",
        "persist-credentials": false
      }
    },
    {
      "name": "Source matches the run commit",
      "run": "sha256:66978ff09fe8da8dd3db7ff1e2ef3a4fb24be2c9978eaabb86aa8cd2b67a0129"
    },
    {
      "name": "App identity and version (pubspec.yaml)",
      "run": "sha256:8aa063377183b36be6eea702b698496e15469361c641dfb0ec55ceb5e786fd02"
    },
    {
      "name": "Central endpoints (config/endpoints.json)",
      "run": "sha256:b00d0ef4f1d0c3d2f211c625c85d00758fc259ee8d5e9919bad7a778f4435d5c"
    },
    {
      "uses": "actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3",
      "with": {
        "distribution": "temurin",
        "java-version": "17"
      }
    },
    {
      "uses": "subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2",
      "with": {
        "flutter-version": "3.47.9",
        "channel": "stable",
        "cache": true
      }
    },
    {
      "name": "Flutter version",
      "run": "sha256:e396d994147f05838798b98ecd2d8b402f89385b0fca5d5f30134c2c71e25f5a"
    },
    {
      "name": "Dependencies",
      "run": "sha256:207a573c49c8a4726e7a33bf0d686373fe4ae4ae38a6258c4133493157910bca"
    },
    {
      "name": "Prepare Android project (push must be on for a release)",
      "env": {
        "FCM_PROJECT_ID": "${{ vars.FCM_PROJECT_ID }}",
        "FCM_SENDER_ID": "${{ vars.FCM_SENDER_ID }}",
        "FCM_APP_ID": "${{ inputs.app == 'ship' && vars.FCM_SHIP_APP_ID || vars.FCM_FOOD_APP_ID }}",
        "FCM_API_KEY": "${{ inputs.app == 'ship' && secrets.FCM_SHIP_API_KEY || secrets.FCM_FOOD_API_KEY }}"
      },
      "run": "sha256:500049b4d84aad637ad6a306dd085beeb6542241d943893d7d3f58fbfa1c5bc6"
    },
    {
      "name": "Offline map package is complete (required)",
      "run": "sha256:5db0839ba29677637742d6607e3d991c1cc6913b616aba9877b0cf7ff0da2bca"
    },
    {
      "name": "Build the release bundle (unsigned by us; Flutter signs it with the debug key)",
      "run": "sha256:88fae98f6fb48f8a1214009bd796bc12c8be5478cd287481ef2cd944c6b99aa8"
    },
    {
      "name": "Sign the bundle with the upload key (single signer)",
      "env": {
        "ANDROID_UPLOAD_KEYSTORE_BASE64": "${{ secrets.ANDROID_UPLOAD_KEYSTORE_BASE64 }}",
        "ANDROID_UPLOAD_KEYSTORE_PASSWORD": "${{ secrets.ANDROID_UPLOAD_KEYSTORE_PASSWORD }}",
        "ANDROID_UPLOAD_KEY_ALIAS": "${{ secrets.ANDROID_UPLOAD_KEY_ALIAS }}",
        "ANDROID_UPLOAD_KEY_PASSWORD": "${{ secrets.ANDROID_UPLOAD_KEY_PASSWORD }}"
      },
      "run": "sha256:cf12ff2ca881364ec6803e66cbee6c929ca81b98a500d4ae80f849f092705db4"
    },
    {
      "name": "Verify the signature (one signer) and the merged manifest",
      "run": "sha256:b36bd1ee6547b68824f9bb17e1fbca5ae84dc7e90d4d00b5f1a8c4d105a7d356"
    },
    {
      "name": "Write the release record (public values only)",
      "run": "sha256:87404f35777c26b097596ddce349f885deeba656cc38fd690a4eb0b0bdf4f33c"
    },
    {
      "name": "Upload the signed bundle and its release record",
      "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
      "with": {
        "name": "${{ env.ARTIFACT_BASENAME }}-aab",
        "path": "${{ runner.temp }}/release/${{ env.ARTIFACT_BASENAME }}.aab\n${{ runner.temp }}/release/${{ env.ARTIFACT_BASENAME }}-release.json\n",
        "if-no-files-found": "error",
        "retention-days": 7
      }
    }
  ],
  "signRun": "set -euo pipefail\nsha256sum -c mobile/release/script-pins.sha256 || { echo \"::error title=script pin::a release script does not match mobile/release/script-pins.sha256; update the pin in the same change\"; exit 1; }\nmkdir -p \"$RUNNER_TEMP/release\"\napp_pin='${{ vars.ANDROID_APP_SIGNER_SHA256 }}'\napp_pin=\"$(printf '%s' \"$app_pin\" | tr 'A-F' 'a-f')\"\nANDROID_APP_SIGNER_PIN=\"$app_pin\" ANDROID_UPLOAD_CERT_PIN='${{ vars.ANDROID_UPLOAD_CERT_SHA256 }}' \\\n  bash mobile/tool/sign-aab.sh \"$RUNNER_TEMP/unsigned.aab\" \"$RUNNER_TEMP/release/$ARTIFACT_BASENAME.aab\" \"$app_pin\"\n",
  "scriptPins": {
    "mobile/tool/app-version.sh": "b6c780e161cba0bbed4e41bc0f0e77ecd97498c363352975d23e180b567226bd",
    "mobile/tool/prepare-android.sh": "97242ece8bb15661e4e5ec36b77a603cdedfbfaef6eec2bf8a9d91615774ae50",
    "mobile/tool/sign-aab.sh": "99bfd773caef6fb9216dac49704ece67587ad460b89bef9cd2a5e8f56c393adc",
    "mobile/tool/check-aab-release.py": "020b32a483e3c9f6f01286d2ac46d569b67273de52186a852e42320a8aee0e87",
    "mobile/tool/play_versioncode_gate.py": "e1d731538fb037a46537d9881f0870d727d3db66419f44fc2be8c2d5fea35b5b"
  }
}
